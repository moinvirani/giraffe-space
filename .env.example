# App (public values - these are compiled into the app bundle).
# Production builds read them from EAS environment variables (environment: production).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
EXPO_PUBLIC_REVENUECAT_APPLE_KEY=your-revenuecat-apple-public-key
EXPO_PUBLIC_REVENUECAT_GOOGLE_KEY=your-revenuecat-google-public-key
EXPO_PUBLIC_REVENUECAT_TEST_KEY=your-revenuecat-test-store-key

# Server secrets live in Supabase Edge Function secrets, never here:
#   supabase secrets set OPENAI_API_KEY=... REVENUECAT_SECRET_KEY=... --project-ref <ref>
